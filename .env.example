# Copy to `.env` (never commit `.env`) and fill in the values:
#     cp .env.example .env

# ============================================================================
# REQUIRED — TabPFN-3.5
# ============================================================================
# Free account + token: https://platform.priorlabs.ai/account/api-keys
TABPFN_API_TOKEN=

# ============================================================================
# REQUIRED for the control-room agent (agent/, webapp agent panel) — any LiteLLM model
# ============================================================================
AGENT_LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Azure OpenAI / other providers: see https://docs.litellm.ai/docs/providers
# and set the matching LITELLM_* / provider-specific env vars instead.

# ============================================================================
# OPTIONAL
# ============================================================================
# DATA_DIR=data                # override the dataset location
# RESULTS_DIR=results          # where results/anomaly/ and metrics_db.json go
